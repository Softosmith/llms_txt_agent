<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- QA-12.  On Odoo 16 this is the screen a website editor actually opens for
         page settings: the frontend "Page Properties" dialog, whose view is fetched
         by reference (`form_view_ref='website.website_page_properties_view_form'`,
         see odoo16/addons/website/static/src/components/dialog/page_properties.js:204).
         Odoo 16 has no website.page.properties transient: that dialog form is a
         `website.page` view (website/views/website_pages_views.xml:31-57), so the
         two controls are added straight onto the page record - which is also what
         makes a write here land on website.page.write and reuse the invalidation
         hook from QA-38, with no second cache-clearing path to keep in sync.
         Core's own controls - Indexed, Published, Visibility, Authorized Groups -
         are all on this same form. -->
    <record id="website_page_properties_view_form_inherit_llm" model="ir.ui.view">
        <field name="name">website.page.form.inherit.llm.properties</field>
        <field name="model">website.page</field>
        <field name="inherit_id" ref="website.website_page_properties_view_form"/>
        <field name="arch" type="xml">
            <!-- "Authorized Groups" is core's last control in the Publish group;
                 anchor on it instead of "//group/*[last()]" so the insertion stays
                 inside the group whatever else inherits this view later. -->
            <xpath expr="//field[@name='groups_id']" position="after">
                <field name="llm_exclude"
                       widget="boolean_toggle"
                       options="{'autosave': False}"
                       help="Omit this page from /llms.txt, /llms-full.txt and the per-page Markdown endpoints."/>
                <field name="llm_custom_description"
                       placeholder="Optional Markdown for AI readers. In llms.txt, Odoo's SEO description is used first and this is the fallback."/>
            </xpath>
        </field>
    </record>
</odoo>
