<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Odoo 20 core added its own "LLMs.txt" setting to this very block:
         <block id="website_settings"> (odoo20/addons/website/views/res_config_settings_views.xml:101,
         titled "Tracking & SEO") holds <setting id="llms_setting"> (...:195-204),
         whose "Edit llms.txt" button opens a wizard over the plain field
         website.llms_txt (odoo20/addons/website/models/website.py:181,
         wizard at odoo20/addons/website/wizard/website_llms.py).
         That is a hand-written file, not a generated one, and core serves it from
         the same /llms.txt URL this app generates from the site's pages.

         The two therefore need to be told apart on screen, and the routes make
         the same promise: with "AI Search SEO" enabled this app answers /llms.txt;
         turn it off and the request falls through to core, so the customer's own
         text is served rather than a 404.  See the handover in
         controllers/main.py. -->
    <record id="res_config_settings_view_form_inherit_website_llms_txt" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.website.llms.txt</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='website_settings']" position="inside">
                <setting id="website_llms_txt_setting" string="AI Search SEO (llms.txt &amp; Markdown)"
                         help="Generates structured machine-readable llms.txt and markdown content exports from your published pages for AI search engines (ChatGPT, Claude, Perplexity, Gemini). Takes over the /llms.txt URL from the manual 'LLMs.txt' setting in this section; disable this option to serve that hand-written text again.">
                    <field name="llm_enabled"/>
                    <div class="content-group" invisible="not llm_enabled">
                        <div class="row mt16">
                            <label class="col-lg-4 o_light_label" string="Site Title" for="llm_site_title"/>
                            <field name="llm_site_title" placeholder="Defaults to Website Name" class="col-lg-8"/>
                        </div>
                        <div class="row mt8">
                            <label class="col-lg-4 o_light_label" string="Site Summary / Tagline" for="llm_site_summary"/>
                            <field name="llm_site_summary" placeholder="Brief overview description of your business/website for AI assistants" class="col-lg-8"/>
                        </div>
                        <div class="row mt8">
                            <label class="col-lg-4 o_light_label" string="LLM Guidance / Prompt" for="llm_site_instructions"/>
                            <field name="llm_site_instructions" placeholder="Additional prompt instructions or context for AI models" class="col-lg-8"/>
                        </div>
                        <div class="row mt16">
                            <div class="col-12 font-weight-bold mb-2">Content Inclusion:</div>
                            <div class="col-12 ms-3" id="llms_txt_agent_content_inclusion">
                                <div>
                                    <field name="llm_include_pages"/>
                                    <label class="o_light_label ms-2" string="Include Published Website Pages" for="llm_include_pages"/>
                                </div>
                            </div>
                        </div>
                        <div class="row mt16">
                            <label class="col-lg-4 o_light_label" string="Generation &amp; Cache Mode" for="llm_cache_ttl"/>
                            <field name="llm_cache_ttl" class="col-lg-8"/>
                        </div>
                        <div class="row mt8" invisible="llm_cache_ttl == 'realtime'">
                            <label class="col-lg-4 o_light_label" string="Cache Last Rebuilt" for="llm_cache_last_updated"/>
                            <div class="col-lg-8 d-flex align-items-center">
                                <field name="llm_cache_last_updated" class="me-3"/>
                                <button name="action_rebuild_llms_cache" type="object" string="Rebuild Cache Now" class="btn btn-sm btn-secondary"/>
                            </div>
                        </div>
                        <div class="mt16 pt-2 border-top">
                            <a href="/llms.txt" target="_blank" role="button" class="btn btn-sm btn-outline-primary me-2">
                                <i class="fa fa-external-link me-1"/> Preview /llms.txt
                            </a>
                            <a href="/llms-full.txt" target="_blank" role="button" class="btn btn-sm btn-outline-secondary">
                                <i class="fa fa-file-text-o me-1"/> Preview /llms-full.txt
                            </a>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
